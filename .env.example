# Shared Capital.com credentials for explicitly selected DEMO or LIVE endpoints.
# Replace placeholders only in .env; DEMO is the application default.
# These names are case-sensitive; python-dotenv supports the hyphenated API key.
X-CAP-API-KEY=your_api_key
identifier=your_login_identifier
password=your_custom_api_password

# Legacy names only. Leave blank; session tokens stay in client memory and are
# never read from or written to this shared file.
CST=
X_SECURITY_TOKEN=
